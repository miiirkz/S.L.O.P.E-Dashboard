# S.L.O.P.E Dashboard Environment Configuration

# Flask Configuration
FLASK_DEBUG=0                    # Set to 0 for production, 1 for development
FLASK_ENV=production             # Set to 'production' or 'development'
FLASK_HOST=127.0.0.1            # Use 127.0.0.1 for localhost only, 0.0.0.0 for all interfaces
FLASK_PORT=5000                  # Port number

# For development, you can use:
# FLASK_DEBUG=1
# FLASK_HOST=0.0.0.0
